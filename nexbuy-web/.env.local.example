# Copy to .env.local and fill in values from your Supabase project.
# .env.local is gitignored.

# ===== Supabase =====
# Get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase (`supabase start`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase status`>
#   SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>

# ===== Resend (transactional email) =====
# https://resend.com/api-keys (key starts with "re_")
# 選填：未設時 sendEmail 會 throw、呼叫端會 warn + 跳過 (不影響主流程)。
# 上線前要把 src/lib/email/send.ts 裡的 DEFAULT_FROM 改成已驗證網域的 address。
RESEND_API_KEY=

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Cron (production only, optional in dev) =====
# Set this in Vercel Dashboard. Vercel sends `Authorization: Bearer ${CRON_SECRET}`
# when invoking /api/cron/* — the route refuses requests that don't match.
# Leave blank in local dev (route is open in dev). Production REQUIRES it set;
# the route returns 500 if it's missing in prod (fail-closed).
CRON_SECRET=

# ===== Upstash Redis (rate limit, production-recommended) =====
# Used by /api/appointments + /api/orders to throttle abuse (5/min, 30/hour
# per IP). Provision via Vercel Marketplace → Upstash, or sign up at
# https://upstash.com (free tier: 10k commands/day).
# Leave blank in local dev — the limiter is a no-op when these are unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
