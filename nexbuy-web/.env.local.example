# Copy to .env.local and fill in values from your Supabase project.
# .env.local is gitignored.

# ===== Supabase =====
# Get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase (`supabase start`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase status`>
#   SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>

# ===== Resend (transactional email) =====
# Real key: https://resend.com/api-keys (starts with "re_")
# Use "dummy" for local dev — emails will log to console instead of being sent.
RESEND_API_KEY=dummy
RESEND_FROM_EMAIL=onboarding@resend.dev

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Cron (production only, optional in dev) =====
# Set this in Vercel Dashboard. Vercel sends `Authorization: Bearer ${CRON_SECRET}`
# when invoking /api/cron/* — the route refuses requests that don't match.
# Leave blank in local dev (route is open in dev).
CRON_SECRET=
