# Copy to .env.test.local for running `pnpm test`.
# .env.test.local is gitignored.
#
# ⚠️ Tests DELETE data — only point this at a local Supabase stack.
# tests/helpers/supabase.ts refuses to run against any host that isn't
# 127.0.0.1 / localhost.

TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_SERVICE_ROLE_KEY=
